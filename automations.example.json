[
  {
    "_comment": "PRESENCE: someone is recognised entering / leaving a room",
    "event": "enter", "person": "Sample Person", "room": "Office",
    "command": "notify-send 'Office' '{person} arrived at {time}'"
  },
  {
    "event": "enter", "person": "*", "room": "Office",
    "webhook": { "url": "http://homeassistant.local:8123/api/webhook/office_lights_on", "method": "POST" }
  },
  {
    "event": "leave", "room": "Office",
    "webhook": { "url": "http://homeassistant.local:8123/api/webhook/office_lights_off", "method": "POST" }
  },

  {
    "_comment": "GESTURES: do the hand sign in front of any camera. {gesture} {person} {room} are substituted.",
    "event": "gesture", "gesture": "Thumb_Up", "room": "Office",
    "webhook": { "url": "http://homeassistant.local:8123/api/webhook/toggle_lights", "method": "POST" }
  },
  {
    "event": "gesture", "gesture": "Open_Palm",
    "command": "echo '{person} waved {gesture} in the {room} at {time}'"
  },
  {
    "event": "gesture", "gesture": "Victory", "person": "Sample Person",
    "command": "notify-send 'Gesture' 'Peace sign by {person} in {room}'"
  },

  {
    "_comment": "AceRGB LIGHTING — drive the desk/rig lights with `ledctl` (loose-coupled; needs acergbd running + ~/bin on PATH). Gestures = deliberate control:",
    "event": "gesture", "gesture": "Pointing_Up",
    "command": "ledctl next-theme"
  },
  {
    "event": "gesture", "gesture": "Closed_Fist",
    "command": "ledctl off"
  },
  {
    "event": "gesture", "gesture": "Thumb_Down",
    "command": "ledctl brightness 30"
  },
  {
    "_comment": "Load a SAVED theme by name (create it first: `ledctl theme save focus`).",
    "event": "gesture", "gesture": "ILoveYou",
    "command": "ledctl theme focus"
  },
  {
    "_comment": "PRESENCE can drive lighting too — e.g. bring the rig up when you arrive, off when you leave:",
    "event": "enter", "person": "Sample Person", "room": "Office",
    "command": "ledctl mode gradient"
  },
  {
    "event": "leave", "room": "Office",
    "command": "ledctl off"
  }
]
