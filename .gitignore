# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Biometric data — NEVER commit enrolled face images
known_faces/*/
!known_faces/.gitkeep

# Large model binaries — download steps in README
models/*.onnx
models/*.task
models/*.pt
*.pt

# Live-verification output — reports and annotated frames of the founder's
# face, written by verify_gestures_live.py. NEVER commit these.
verification/

# Scanner output and test sets — local only (may contain biometric copies)
photo_matches/
test_photo_matches/
test_photos/
matches/
output/

# Local databases — runtime state
*.db
*.sqlite
*.sqlite3

# WiFi + other secrets
esp32cam/CameraWebServer/secrets.h

# Local configs with real paths/passwords (examples are committed)
automations.json
cameras.json

# ESP32 compiled firmware (large binaries, reproducible from source)
esp32cam/build/
esp32cam/CameraWebServer/build/

# macOS / IDE
.DS_Store
.idea/
*.swp

# local secrets for watch_person.py (Telegram creds)
.env
watch_cameras.json

# Recordings — RecordingOutput refuses to write anywhere under this checkout
# (acesvision/recording.py:refuse_repo_path), and this is the second lock on
# the same door. A recording is a video of a room and the people in it; this
# repository is published.
*.mp4
*.mp4.json
